# Browser key for Google Maps (Maps JavaScript API, Places API (New), Routes API).
# Restrict it by HTTP referrer to your deployed domain.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: your own Google map ID (defaults to DEMO_MAP_ID).
NEXT_PUBLIC_GOOGLE_MAP_ID=
# Backend for the /demo sample days.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Any MapLibre style URL. Default is OpenFreeMap (free, no key).
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
