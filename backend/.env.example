# Copy to .env. Any provider left blank is skipped; with none set, the API
# falls back to the offline mock provider (straight-line estimates).
WAYFINDER_GOOGLE_MAPS_API_KEY=
WAYFINDER_AMAP_API_KEY=
# Switch to the overseas (Singapore) endpoint once that service is provisioned.
WAYFINDER_AMAP_BASE_URL=https://restapi.amap.com
WAYFINDER_BAIDU_AK=
# auto | mock | google | amap | baidu
WAYFINDER_MAP_PROVIDER_OVERRIDE=auto
WAYFINDER_DATABASE_URL=postgresql://wayfinder:wayfinder@localhost:5432/wayfinder
WAYFINDER_REDIS_URL=redis://localhost:6379/0
